# ============================================================
# DEVELOPMENT CONFIGURATION EXAMPLE
# ============================================================
# Copy this file to .env and adjust values for your development environment

# Application
APP_NAME=multi-agent-research-assistant
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI/LLM Configuration (Development - Local Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120
OLLAMA_DISABLE_REASONING=true
OLLAMA_STREAM=false
OLLAMA_REPORT_TEMPERATURE=0.3
OLLAMA_REPORT_MAX_TOKENS=384
OLLAMA_REPORT_TIMEOUT=60

# RAG Configuration (for future use)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K_RESULTS=5

# Security (Development)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174","http://localhost:4173","http://127.0.0.1:4173"]
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# PRODUCTION CONFIGURATION EXAMPLE
# ============================================================
# For production deployment, adjust the following values:

# APP_ENV=production
# APP_DEBUG=false

# CORS_ORIGINS=["https://your-domain.example"]

# SQLite Database Paths (Production/Docker):
# RESEARCH_MEMORY_DB_PATH=/app/data/research_memory.db
# EVALUATION_METRICS_DB_PATH=/app/data/evaluation_metrics.db

# Ollama Configuration (Production):
# For Docker Desktop with Ollama on host:
# OLLAMA_HOST=http://host.docker.internal:11434
# For internal Ollama service in Docker Compose:
# OLLAMA_HOST=http://ollama:11434
# For remote Ollama server:
# OLLAMA_HOST=http://your-ollama-server:11434

# LOG_LEVEL=WARNING or LOG_LEVEL=INFO for production
